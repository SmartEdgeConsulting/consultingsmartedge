// sendNewsletter.js
const { Resend } = require('resend');
const resend = new Resend('your_api_key');

async function sendNewsletterWithResend(subject, htmlContent) {
  try {
    // Get all confirmed subscribers
    const subscribers = await pool.query(
      'SELECT email FROM subscribers WHERE confirmed = true AND is_active = true'
    );

    // Resend allows batch sending
    const emails = subscribers.rows.map(sub => sub.email);
    
    // Send in batches of 100 (Resend's limit)
    for (let i = 0; i < emails.length; i += 100) {
      const batch = emails.slice(i, i + 100);
      
      await resend.emails.send({
        from: 'newsletter@yourdomain.com',
        to: batch,
        subject: subject,
        html: htmlContent,
        // Add unsubscribe link
        headers: {
          'List-Unsubscribe': '<https://yourdomain.com/unsubscribe>'
        }
      });
      
      console.log(`Sent newsletter to batch ${i / 100 + 1}`);
    }

    console.log('Newsletter sent successfully!');
  } catch (error) {
    console.error('Error sending newsletter:', error);
  }
}

