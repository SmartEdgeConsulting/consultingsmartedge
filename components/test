// middleware.ts (in root directory)
import { NextResponse } from 'next/server';
import type { NextRequest } from 'next/server';

export function middleware(request: NextRequest) {
  // Get token from cookies
  const token = request.cookies.get('auth-token')?.value;
  
  // Define protected routes
  const protectedPaths = ['/dashboard', '/profile', '/settings'];
  const isProtectedPath = protectedPaths.some(path => 
    request.nextUrl.pathname.startsWith(path)
  );
  
  // If accessing protected route without token, redirect to signup
  if (isProtectedPath && !token) {
    const url = request.nextUrl.clone();
    url.pathname = '/signup';
    url.searchParams.set('redirect', request.nextUrl.pathname);
    return NextResponse.redirect(url);
  }
  
  // If has token but accessing auth pages, redirect to dashboard
  if (token && (request.nextUrl.pathname === '/signup' || 
                 request.nextUrl.pathname === '/login')) {
    return NextResponse.redirect(new URL('/dashboard', request.url));
  }
  
  return NextResponse.next();
}

// Configure which paths the middleware runs on
export const config = {
  matcher: [
    '/dashboard/:path*',
    '/profile/:path*',
    '/settings/:path*',
    '/signup',
    '/login'
  ]
};

// auth.ts (NextAuth v5 / Auth.js)
import NextAuth from "next-auth";
import Credentials from "next-auth/providers/credentials";

export const { handlers, signIn, signOut, auth } = NextAuth({
  providers: [
    Credentials({
      credentials: {
        email: { label: "Email", type: "email" },
        password: { label: "Password", type: "password" }
      },
      authorize: async (credentials) => {
        // Verify credentials against your database
        const user = await getUserFromDb(credentials.email, credentials.password);
        
        if (user) {
          // Return user object - this gets encoded into JWT
          return {
            id: user.id,
            email: user.email,
            name: user.name
          };
        }
        return null;
      }
    })
  ],
  
  callbacks: {
    // This runs when JWT is created/updated
    async jwt({ token, user }) {
      // Add custom fields to token
      if (user) {
        token.id = user.id;
        token.role = user.role; // Add custom data
      }
      return token;
    },
    
    // This runs when session is accessed
    async session({ session, token }) {
      // Pass token data to session
      if (token) {
        session.user.id = token.id;
        session.user.role = token.role;
      }
      return session;
    }
  },
  
  session: {
    strategy: "jwt", // Use JWT tokens
    maxAge: 30 * 24 * 60 * 60, // 30 days
  },
  
  pages: {
    signIn: '/login',
  }
});




// sendNewsletter.js
const { Resend } = require('resend');
const resend = new Resend('your_api_key');

async function sendNewsletterWithResend(subject, htmlContent) {
  try {
    // Get all confirmed subscribers
    const subscribers = await pool.query(
      'SELECT email FROM subscribers WHERE confirmed = true AND is_active = true'
    );

    // Resend allows batch sending
    const emails = subscribers.rows.map(sub => sub.email);
    
    // Send in batches of 100 (Resend's limit)
    for (let i = 0; i < emails.length; i += 100) {
      const batch = emails.slice(i, i + 100);
      
      await resend.emails.send({
        from: 'newsletter@yourdomain.com',
        to: batch,
        subject: subject,
        html: htmlContent,
        // Add unsubscribe link
        headers: {
          'List-Unsubscribe': '<https://yourdomain.com/unsubscribe>'
        }
      });
      
      console.log(`Sent newsletter to batch ${i / 100 + 1}`);
    }

    console.log('Newsletter sent successfully!');
  } catch (error) {
    console.error('Error sending newsletter:', error);
  }
}

